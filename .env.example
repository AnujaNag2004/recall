# Copy to .env for the API, and copy the NEXT_PUBLIC_* lines to apps/web/.env.local
# for the web app. Never commit real values.
# Variables under "Later phases" are listed now so the full set is visible in one
# place; each one starts being read in the phase named.

# -----------------------------------------------------------------------------
# API: core (read now)
# -----------------------------------------------------------------------------
APP_ENV=development
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000
# docker-compose database; for Supabase, use the pooler URI from
# Project Settings > Database, with the scheme changed to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/recall

# -----------------------------------------------------------------------------
# Web
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# Phase 1. Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Later phases: Supabase, server side (Phase 1)
# -----------------------------------------------------------------------------
SUPABASE_URL=
# Bypasses row-level security. Server only: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=saves

# -----------------------------------------------------------------------------
# Later phases: AI providers (Phase 2)
# Model IDs are set after checking each provider's current docs.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_FAST_MODEL=
GEMINI_STRONG_MODEL=
GEMINI_EMBEDDING_MODEL=
# Must match the vector(N) column in supabase/migrations.
EMBEDDING_DIM=768
GROQ_API_KEY=
GROQ_FAST_MODEL=
GROQ_STRONG_MODEL=
GROQ_WHISPER_MODEL=
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Later phases: scheduled agents (Phase 5)
# -----------------------------------------------------------------------------
# Shared secret that GitHub Actions sends to /internal/cron/*.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Later phases: Google Calendar and integrations (Phase 7)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Fernet key for stored OAuth tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Optional: enables Instagram/Facebook oEmbed (Phase 2 falls back to a thumbnail).
META_OEMBED_TOKEN=

# -----------------------------------------------------------------------------
# Later phases: rate limits, cache, observability (Phase 8)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
DAILY_AI_USAGE_CAP=200

# -----------------------------------------------------------------------------
# Stretch: weekly digest email
# -----------------------------------------------------------------------------
RESEND_API_KEY=
